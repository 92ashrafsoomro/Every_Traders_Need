{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "resources/js/*"
      ],
      "@stores/*": [
        "resources/js/stores/*"
      ],
      "@services/*": [
        "resources/js/core/services/*"
      ],
      "@utils/*": [
        "resources/js/core/utils/*"
      ],
      "@components/*": [
        "resources/js/core/components/*"
      ],
      "@plugins/*": [
        "resources/js/core/plugins/*"
      ],
      "@images/*": [
        "resources/js/images/*"
      ],
    },
    "ignoreDeprecations": "6.0"
  },
  "exclude": [
    "node_modules",
    "public"
  ]
}